APP_NAME="Superintendent of Police, Pabna"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.gov.bd

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=PabnaPolice
DB_USERNAME=
DB_PASSWORD=
# Same prefix the Yii app used, so the existing tables are reused as they are.
DB_PREFIX=os_

# The Yii app stored unsalted SHA1 passwords. They are accepted at login either way.
# Set to true ONLY after the old Yii admin is retired: users are then rehashed to bcrypt
# on their next login, and the Yii admin can no longer verify those passwords.
LEGACY_PASSWORD_UPGRADE=false

# The schema-normalisation migrations (rename tables/columns, utf8mb4, foreign keys) make the old Yii app unusable,
# so they refuse to run until you confirm it has been switched off. Leave false until then.
YII_RETIRED=false

# Mail is needed for password-reset e-mails. Use your host's SMTP details; "log" only writes mails to storage/logs.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=sppabna@police.gov.bd
MAIL_FROM_NAME="${APP_NAME}"
# Where backup success/failure notices go.
BACKUP_NOTIFY_EMAIL=

# Secret for GET /health?token=... (detailed checks). Leave empty to only expose ok/fail.
HEALTH_TOKEN=
# Set to the reverse proxy's IP(s), comma separated, or * , only if the site is behind one.
TRUSTED_PROXIES=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
